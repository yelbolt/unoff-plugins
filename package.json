{
  "name": "unoff-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo of plugins generated by the UNOFF framework, organized by design tool platform.",
  "license": "MIT",
  "workspaces": [
    "penpot/*",
    "figma/*",
    "framer/*",
    "sketch/*"
  ],
  "scripts": {
    "build:all": "npm run build:prod --workspaces --if-present",
    "build:penpot": "node scripts/build-platform.mjs penpot production",
    "dev:penpot": "node scripts/build-platform.mjs penpot development",
    "serve": "http-server dist -p 4400 --cors -c-1",
    "start:penpot": "npm run dev:penpot & npm run serve"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
